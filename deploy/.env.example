# 배포 서버(EC2)와 로컬 검증에 쓰는 설정. 이 파일을 복사해 deploy/.env 를 만들고 값을 채운다.
# 로컬 검증(DEPLOY.md 0-1장)에서는 DOMAIN=localhost 로 두고 docker-compose.local.yml 과 함께 띄운다.
#   cp .env.example .env && chmod 600 .env
# deploy/.env 는 .gitignore에 있어 저장소에 올라가지 않는다. 값은 절대 커밋하지 않는다.

# 접속 도메인. DuckDNS 등 무료 서브도메인도 된다. 이 이름으로 HTTPS 인증서가 발급된다.
DOMAIN=example.duckdns.org
# 인증서 만료 알림용(선택). 비워 둬도 발급된다.
ACME_EMAIL=

# MySQL 컨테이너 비밀번호. 아무 데도 쓰이지 않는 긴 임의 문자열로 만든다.
#   예: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# 앱이 처음 뜰 때 만드는 제출용 계정(관리자 admin / 직원 emp001)의 비밀번호.
# 이미 있는 계정은 건드리지 않으므로, 나중에 값을 바꿔도 비밀번호가 되돌아가지 않는다.
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=

# 외부 Background Check API 인증키(과제 안내 메일의 값).
# 없으면 앱은 뜨지만 배경 조회가 '요청 대기'에서 멈춘다.
CANDIDATE_KEY=
